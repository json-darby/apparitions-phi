# Copy to .env.local at the very end. Never commit .env.local.
# Project that holds the free-trial credit (sign in with: gcloud auth application-default login)
PHI_GCP_PROJECT=
# Region for Gemini calls
PHI_GCP_LOCATION=global
# Or, instead of the project: a Vertex API key (express mode)
PHI_API_KEY=
# Hard spending cap for the whole pipeline, in USD
PHI_BUDGET_USD=30
