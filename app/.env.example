# Build-time settings for the app. Copy to .env.local (ignored by git) to use.
# Never put a key, token or access code here: everything in a VITE_ variable is
# built into the public JavaScript that anyone can read.

# The live server's address, used until a different one is set on the device in
# Settings → Talk live (where the access code is entered too). Leave unset to
# default to the server on this computer, http://127.0.0.1:8787.
# VITE_PHI_SERVER=https://phi-server-xxxxxxxxxx-nw.a.run.app
